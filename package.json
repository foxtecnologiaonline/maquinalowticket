{
  "name": "maquinalowticket",
  "version": "0.0.1",
  "description": "Low-Ticket Product Factory - Full Factory Escalável",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
